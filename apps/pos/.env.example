# Kasa programi ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
#
# NOT: Bu degerler derlenen .exe icine gomulur. ANON anahtar icin bu sorun
# degildir - yetkisi RLS ile sinirlidir ve zaten musterinin telefonundaki QR
# menude de bulunur. SERVICE ROLE anahtarini BURAYA ASLA YAZMAYIN.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# QR menu sitesinin adresi (QR etiketi bu adresi gosterir)
VITE_MENU_URL=https://menu-adresi.vercel.app

# "Menüyü yayınla" dugmesinin kullandigi gizli anahtar.
# apps/menu tarafindaki REVALIDATE_SECRET ile AYNI olmali.
VITE_REVALIDATE_SECRET=
