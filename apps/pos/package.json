{
  "name": "@adisyon/pos",
  "version": "0.1.0",
  "private": true,
  "description": "Kokoreççi adisyon ve kasa programı",
  "//surum-notu": [
    "vite ~7.3.6 ve @vitejs/plugin-react ~5.2.0 bilincli olarak sabitlendi:",
    "electron-vite 5 henuz Vite 8'i desteklemiyor (peer: ^5 || ^6 || ^7),",
    "plugin-react 6.x ise Vite 8 istiyor. Bu ucluyu birlikte yukseltmek gerekir."
  ],
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@adisyon/shared": "*",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.101.4",
    "node-thermal-printer": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "~5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "~7.3.6"
  }
}
