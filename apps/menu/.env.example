# QR menu sitesi ortam degiskenleri
# Bu dosyayi ".env.local" olarak kopyalayip degerleri doldurun.
# Vercel'de ayni degiskenler proje ayarlarindan (Environment Variables) girilir.

# Supabase proje URL'i  (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# ANON (public) anahtar. Tarayiciya gonderilir - bu normaldir, yetkisi RLS ile
# menu tablolarini okumaya kilitlidir.
# SERVICE ROLE anahtarini BURAYA ASLA YAZMAYIN.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# "Menüyü yayınla" dugmesinin kullandigi gizli anahtar.
# Kasa programindaki ayni deger ile eslesmeli. Rastgele uretin, or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
